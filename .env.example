# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=strandarr
POSTGRES_PORT=5432

WEB_PORT=8000

STRANDARR_DOMAIN=strandarr.loaki.fr
TRAEFIK_NETWORK=traefik
# Traefik middlewares
STRANDARR_MIDDLEWARES=default-auth@file,secure-headers@file,rate-limit@file

PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change_me
PGADMIN_PORT=5050
PGADMIN_BIND=127.0.0.1

# Global Fishing Watch (https://globalfishingwatch.org/our-apis/tokens)
GFW_API_TOKEN=

# AISStream (https://aisstream.io)
AISSTREAM_API_KEY=

# Copernicus Marine (https://data.marine.copernicus.eu/register)
CMEMS_USERNAME=
CMEMS_PASSWORD=

# Where the CMEMS NetCDF files are cached between download and drift
FORCING_DIR=forcing

# How many hours ahead the forecast reaches, and so how far the map predicts
FORECAST_HOURS=72

# Sampling grid for wind, sea state and the map
GRID_STEP_DEG=0.25

# How far from shore to sample, in km. Cells further out are never requested.
MAX_DISTANCE_TO_COAST_KM=200

# How far inland to keep sampling. Sea cells are kept to the limit above; land
# cells only this close, where the marine model can still answer. Which cells are
# sea is settled once and stored in strandarr/grid_points.json -- change either
# limit and you have to rebuild it with scripts/build-grid.py.
COASTAL_LAND_MARGIN_KM=30

# Where `strandarr fit` writes its coefficients. Docker Compose points this at a
# volume so a rebuilt image does not discard a fit. Leave it empty to use the
# copy shipped inside the package.
COEFFICIENTS_PATH=
