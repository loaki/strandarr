# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=strandarr
POSTGRES_PORT=5432

WEB_PORT=8000

STRANDARR_DOMAIN=strandarr.loaki.fr
TRAEFIK_NETWORK=traefik
# Traefik middlewares
STRANDARR_MIDDLEWARES=default-auth@file,secure-headers@file,rate-limit@file

# pgAdmin
PGADMIN_EMAIL=admin@pgadmin.localhost
PGADMIN_PASSWORD=change_me
PGADMIN_PORT=5050

# Global Fishing Watch (https://globalfishingwatch.org/our-apis/tokens)
GFW_API_TOKEN=

# AISStream (https://aisstream.io)
AISSTREAM_API_KEY=

# How many hours ahead the forecast ingest collects
MARINE_FORECAST_HOURS=48

# Sampling grid. 0.25 divides exactly by 0.125 and 1/12, so refining to either
# keeps every cell already stored. Open-Meteo's marine fields are ~1/12 deg.
GRID_STEP_DEG=0.25

# How far offshore to sample, in km
MAX_DISTANCE_TO_COAST_KM=200

# How far inland to keep sampling. Sea cells are kept to the limit above;
# land cells only this close, where the marine model can still answer.
COASTAL_LAND_MARGIN_KM=30
